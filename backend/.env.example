# ───────────────────────────────────────────
# Community ID Backend — Environment Variables
# ───────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Supabase ──────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Server ────────────────────────────────
PORT=5000
NODE_ENV=development

# ── CORS ──────────────────────────────────
# Comma-separated origins allowed to call this API.
# In development, Vite runs on 5173 by default.
CORS_ORIGIN=http://localhost:5173

# ── Frontend URL ──────────────────────────
# Used by Puppeteer (cardRenderer) to load the card preview page.
# Set to your deployed frontend URL in production.
FRONTEND_URL=http://localhost:5173

# ── Brevo (Email) ─────────────────────────
# Get your API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-your-brevo-api-key-here
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=Community ID

# ── Admin ─────────────────────────────────
# Comma-separated Supabase user UUIDs that get unlimited tokens.
# These users bypass all token checks (infinite credits for testing).
ADMIN_USER_IDS=

# ── Limits ────────────────────────────────
# Max members per API batch (default: 50)
BULK_BATCH_LIMIT=50
