# ───────────────────────────────────────────
# Community ID Frontend — Environment Variables
# ───────────────────────────────────────────
# Copy this file to .env and fill in real values.
# All VITE_ prefixed vars are exposed to the browser.

# ── Supabase ──────────────────────────────
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Backend API URL ───────────────────────
# Used by Dashboard, Tokens, Webhooks, Bulk generation, etc.
VITE_API_URL=http://localhost:5000
# Legacy alias (used by image proxy & some pages)
VITE_BACKEND_URL=http://localhost:5000

# ── Bulk Generation Limits ────────────────
# Daily upload limit per user (default: 200)
VITE_BULK_DAILY_LIMIT=200
# Max members in a single generation queue (default: 500)
VITE_BULK_MAX_QUEUE=500

# IMPORTANT: Never expose the service_role key in the frontend.
# The anon key is safe for frontend use — it respects RLS policies.
